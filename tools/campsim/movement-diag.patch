 // Returns 0 if nothing happened, -1 if unit moved 'Here', 1 if unit actually moved
+// TEMPORARY movement diagnostics (campsim). Columns: 0 MoveUnit calls, 1 step attempts,
+// 2 bad heading, 3 not aggregate/real, 4 not enough move time, 5 zero cost, 6 moved,
+// 7 stopped by DetectOnMove, 8 was ever on CAPTURE orders, 9 enough time
+// Second array: DetectOnMove stops -- 0 ChooseTarget<0, 1 attack before actionTime,
+// 2 DetectVs nomove, 3 captures triggered.
+int gMvDiag[8192][10];
+int gMvDiag2[8192][4];
+double gMvCostSum[8192];
+double gMvTimeSum[8192];
+
+void CampsimDumpMoveDiag(void)
+{
+    int n = 0;
+    printf("MVDIAG id team calls steps badH notAgg noTime zeroCost moved detStop | chooseTarget attackEarly detectVsNoMove captures | avgCost_s avgHave_s\n");
+
+    for (int i = 0; i < 8192; i++)
+    {
+        if (not gMvDiag[i][8])
+            continue;
+
+        n++;
+        int s = gMvDiag[i][1] ? gMvDiag[i][1] : 1;
+        printf("MVDIAG %d %d %d %d %d %d %d %d %d %d | %d %d %d %d | %.0f %.0f\n", i, gMvDiag[i][9], gMvDiag[i][0], gMvDiag[i][1],
+               gMvDiag[i][2], gMvDiag[i][3], gMvDiag[i][4], gMvDiag[i][5], gMvDiag[i][6],
+               gMvDiag[i][7], gMvDiag2[i][0], gMvDiag2[i][1], gMvDiag2[i][2], gMvDiag2[i][3],
+               gMvCostSum[i] / s / 1000.0, gMvTimeSum[i] / s / 1000.0);
+    }
+
+    printf("MVDIAG units=%d\n", n);
+}
